    private void Arrange(){if(Items.Count==0)return;var geometry=Items.Select(item=>{var dimensions=item.Asset.ViewBox.Split(' ',StringSplitOptions.RemoveEmptyEntries);return new SceneObjectGeometry(double.Parse(dimensions[^2],CultureInfo.InvariantCulture),double.Parse(dimensions[^1],CultureInfo.InvariantCulture),item.Asset.Role,item.NormalizedX,item.Depth,item.Emphasis,item.Rotation,item.Asset.Concept,item.Importance,item.NormalizedY);}).ToArray();var placements=SceneLayoutEngine.Arrange(Width,Height,geometry,CompositionDensity,Layout,Relationships,CompositionIntent);for(var index=0;index<Items.Count;index++){var placement=placements[index];Items[index].X=placement.X;Items[index].Y=placement.Y;Items[index].W=placement.Width;Items[index].H=placement.Height;Items[index].Rotation=placement.RotationDegrees;Items[index].Emphasis=placement.Emphasis;Items[index].Z=placement.ZOrder*100+placement.Emphasis*10;}}
    private SceneSuggestionAsset CreateSuggestionAsset(Asset asset)
    {
        var dimensions = asset.ViewBox.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var width = double.Parse(dimensions[^2], CultureInfo.InvariantCulture);
        var height = double.Parse(dimensions[^1], CultureInfo.InvariantCulture);
        var full = Path.GetFullPath(Path.Combine(Host.WebRootPath, "Assets", asset.Svg));
        var primitives = XDocument.Load(full).Descendants()
            .Where(element => element.Name.LocalName is "path" or "polygon" or "polyline" or "rect" or "circle" or "ellipse" or "line")
            .ToArray();
        var paths = primitives.Where(element => element.Name.LocalName == "path").ToArray();
        var closedPaths = paths.Count(element => System.Text.RegularExpressions.Regex.IsMatch((string?)element.Attribute("d") ?? "", @"[zZ]\s*$"));
        var curvedPaths = paths.Count(element => System.Text.RegularExpressions.Regex.IsMatch((string?)element.Attribute("d") ?? "", @"[cCsSqQtTaA]"));
        var primitiveKinds = string.Join(", ", primitives.GroupBy(element => element.Name.LocalName)
            .OrderBy(group => group.Key, StringComparer.Ordinal)
            .Select(group => $"{group.Count()} {group.Key}"));
        var ratio = width / height;
        var silhouette = ratio > 1.35 ? "wide silhouette" : ratio < 0.8 ? "tall silhouette" : "balanced silhouette";
        var contour = $"{silhouette}; {closedPaths} closed and {paths.Length - closedPaths} open paths; {curvedPaths} curved paths; {primitiveKinds}";
        var colorRoles = asset.ColorRoles?.Select(role => new SceneSuggestionColorRole(role.SourceColor, role.Role, role.Behavior)).ToArray();
        return new(asset.Concept, asset.Name, asset.Role, asset.Size, asset.Tags, width, height, primitives.Length, contour,
            SceneThemePolicy.VisualRegionsFor(asset.Concept), colorRoles);
    }
    private void Rotate(){if(Selected is not null)Selected.Rotation=(Selected.Rotation+15)%360;} private void Duplicate(){if(Selected is not null){var d=new SceneItem{Asset=Selected.Asset,X=Selected.X+30,Y=Selected.Y+30,W=Selected.W,H=Selected.H,Rotation=Selected.Rotation,Emphasis=Selected.Emphasis,Depth=Selected.Depth,NormalizedX=Selected.NormalizedX,NormalizedY=Selected.NormalizedY,Relevance=Selected.Relevance,Importance=Selected.Importance,Complexity=Selected.Complexity,SceneFunction=Selected.SceneFunction,ColorAssignments=new Dictionary<string,string>(Selected.ColorAssignments,StringComparer.Ordinal),Z=Items.Count};Items.Add(d);Selected=d;}} private void Delete(){if(Selected is not null){Remove(Selected);}} private void Remove(SceneItem i){Items.Remove(i);Relationships.RemoveAll(relation=>relation.SourceConceptId==i.Asset.Concept||relation.TargetConceptId==i.Asset.Concept);if(Selected==i)Selected=null;}
