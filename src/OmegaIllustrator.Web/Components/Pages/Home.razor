    private string AssetHref(Asset asset)=>AssetHref(asset,null);
    private string AssetHref(Asset asset,IReadOnlyDictionary<string,string>? colorAssignments)
    {
        var assignmentKey=colorAssignments is null?"":string.Join(";",colorAssignments.OrderBy(pair=>pair.Key,StringComparer.Ordinal).Select(pair=>$"{pair.Key}={pair.Value}"));
        var key=(asset.Id,ActivePalette,assignmentKey); if(SvgCache.TryGetValue(key,out var cached))return cached;
        var full=Path.GetFullPath(Path.Combine(Host.WebRootPath,"Assets",asset.Svg));
        var basePath=Path.GetFullPath(Path.Combine(Host.WebRootPath,"Assets"))+Path.DirectorySeparatorChar;
        if(!full.StartsWith(basePath,StringComparison.OrdinalIgnoreCase))return "";
        var text=File.ReadAllText(full);
        foreach(var pair in AssetPaletteMap(ActivePalette,asset,colorAssignments)) text=System.Text.RegularExpressions.Regex.Replace(text,System.Text.RegularExpressions.Regex.Escape(pair.Key),pair.Value,System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return SvgCache[key]="data:image/svg+xml;base64,"+Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(text));
    }
    private IReadOnlyDictionary<string,string> AssetPaletteMap(string palette,Asset asset,IReadOnlyDictionary<string,string>? colorAssignments=null)
    {
        var sourceRoles=asset.ColorRoles?.Select(role=>new SceneSuggestionColorRole(role.SourceColor,role.Role,role.Behavior));
        return Palettes?.CreateAssetColorMap(palette,asset.Role,sourceRoles,colorAssignments)
            ?? SvgSceneExporter.PaletteMap(palette);
    }
    private async Task Export(){var items=Items.Where(x=>ShowBackground||x.Asset.Role!="background").OrderBy(i=>i.Z).Select(i=>new SceneSvgItem(Path.Combine(Host.WebRootPath,"Assets",i.Asset.Svg),i.X,i.Y,i.W,i.H,i.Rotation,i.Id,i.Asset.Concept,i.Asset.Role,AssetPaletteMap(ActivePalette,i.Asset,i.ColorAssignments),i.Relevance,i.Importance,i.Complexity));var paletteMap=Palettes?.CreateColorMap(ActivePalette)??SvgSceneExporter.PaletteMap(ActivePalette);var svg=SvgSceneExporter.Export(Width,Height,PaletteBg,paletteMap,items);await JS.InvokeVoidAsync("omegaDownload",Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg)),"omega-composition.svg");}
