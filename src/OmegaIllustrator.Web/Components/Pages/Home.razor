    private static string ChooseOfflinePalette(IReadOnlyList<string> terms)=>terms.Any(term=>term.Contains("финанс",StringComparison.Ordinal)||term.Contains("делов",StringComparison.Ordinal)||term.Contains("серьез",StringComparison.Ordinal))?"palette-3":terms.Any(term=>term.Contains("отдых",StringComparison.Ordinal)||term.Contains("перерыв",StringComparison.Ordinal)||term.Contains("спокой",StringComparison.Ordinal)||term.Contains("тих",StringComparison.Ordinal)||term.Contains("умиротвор",StringComparison.Ordinal))?"palette-3":terms.Any(term=>term.Contains("тепл",StringComparison.Ordinal)||term.Contains("радост",StringComparison.Ordinal)||term.Contains("энерг",StringComparison.Ordinal))?"palette-2":"palette-1";
    private static List<SceneRelationship> BuildCuratedRelationships(IReadOnlySet<string> concepts, IReadOnlyList<string> terms)
    {
        var focus = SceneThemePolicy.PreferredFinancialFocus(terms, concepts)
            ?? SceneThemePolicy.PreferredRestFocus(terms, concepts)
            ?? (concepts.Contains("book") ? "book" : concepts.Contains("folder") ? "folder" : concepts.FirstOrDefault());
        if (focus is null) return [];

        var intent = SceneThemePolicy.InferCompositionIntent(terms);
        return concepts
            .Where(concept => concept != focus)
            .Select(concept => SceneThemePolicy.RecommendRelationship(concept, focus, concepts, intent))
            .Where(relation => relation is not null && SceneThemePolicy.AllowsRelationship(relation.SourceConceptId, relation.TargetConceptId, relation.Type))
            .Select(relation => relation!)
            .ToList();
    }
